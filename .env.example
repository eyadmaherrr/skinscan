# ---------------------------------------------------------------------------
# SkinScan by Dr Maher — environment variables (copy to .env.local for development).
# Every value is optional; the defaults are shown.
# ---------------------------------------------------------------------------

# Public URL of the app (used for metadata / Open Graph). Production:
# NEXT_PUBLIC_APP_URL=https://skinscan.drmahermahmoud.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the scan API. Leave empty to call the API on the same origin
# (recommended). Set it only if the API is hosted separately.
NEXT_PUBLIC_API_BASE_URL=

# "Book a Consultation" button and clinic links.
NEXT_PUBLIC_BOOKING_URL=https://drmahermahmoud.com/book
NEXT_PUBLIC_CLINIC_URL=https://drmahermahmoud.com

# --- Server-side (never exposed to the browser) -----------------------------

# Folder containing the ONNX models and manifest.json (default: ./models).
SKIN_SCAN_MODEL_DIR=

# Upload and processing limits.
SKIN_SCAN_MAX_UPLOAD_MB=8
SKIN_SCAN_MAX_INPUT_MEGAPIXELS=40
SKIN_SCAN_MAX_ANALYSIS_SIDE=2560
SKIN_SCAN_TIMEOUT_MS=25000
SKIN_SCAN_MAX_CONCURRENT=2
SKIN_SCAN_ONNX_THREADS=2

# Rate limit: scans per client IP per window (in-memory, per server instance).
SKIN_SCAN_RATE_LIMIT=8
SKIN_SCAN_RATE_LIMIT_WINDOW_SECONDS=600

# Skip ONNX Runtime's optional CUDA download during `npm install` on Linux
# (also set in .npmrc). Set this in CI/hosting environments too.
ONNXRUNTIME_NODE_INSTALL=skip

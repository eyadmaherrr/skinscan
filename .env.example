# ---------------------------------------------------------------------------
# SkinScan by Dr Maher — environment variables (copy to .env.local for development).
# Every value is optional; the defaults are shown.
# ---------------------------------------------------------------------------

# Public URL of the app (used for metadata / Open Graph). Production:
# NEXT_PUBLIC_APP_URL=https://skinscan.drmahermahmoud.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the scan API. Leave empty to call the API on the same origin
# (recommended). Set it only if the API is hosted separately.
NEXT_PUBLIC_API_BASE_URL=

# "Book a Consultation" button and clinic links. Patients sign in on the
# clinic website (email/password or Google), which sends them back here.
NEXT_PUBLIC_BOOKING_URL=https://www.drmahermahmoud.com/book
NEXT_PUBLIC_CLINIC_URL=https://www.drmahermahmoud.com

# --- Server-side (never exposed to the browser) -----------------------------

# Patient sign-in. Scans require a signed-in clinic patient; the session is
# checked with the clinic website's /api/auth/me. Sign-in only works when
# SkinScan runs on a drmahermahmoud.com subdomain (the session cookie is shared
# across the domain), so set SKINSCAN_REQUIRE_AUTH=false for local development.
SKINSCAN_REQUIRE_AUTH=true
# Clinic website used for session checks (defaults to NEXT_PUBLIC_CLINIC_URL).
CLINIC_URL=

# Folder containing the ONNX models and manifest.json (default: ./models).
SKIN_SCAN_MODEL_DIR=

# Upload and processing limits.
SKIN_SCAN_MAX_UPLOAD_MB=8
SKIN_SCAN_MAX_INPUT_MEGAPIXELS=40
SKIN_SCAN_MAX_ANALYSIS_SIDE=2560
SKIN_SCAN_TIMEOUT_MS=25000
SKIN_SCAN_MAX_CONCURRENT=2
SKIN_SCAN_ONNX_THREADS=2

# Rate limit: scans per client IP per window (in-memory, per server instance).
SKIN_SCAN_RATE_LIMIT=8
SKIN_SCAN_RATE_LIMIT_WINDOW_SECONDS=600

# --- Experimental extensions -------------------------------------------------
SKINSCAN_ACNE_LESIONS=true
SKINSCAN_PORES=true
# Optional acne-severity classifier (unresolved data licence; see docs/AI_SOURCES.md).
# SKINSCAN_ACNE_SEVERITY_MODEL=acne_severity.onnx   (file name inside models/optional/)
SKINSCAN_ACNE_SEVERITY_MODEL=
# Optional self-hosted Derm Foundation embedding service (services/derm-foundation).
DERM_FOUNDATION_ENABLED=false
DERM_FOUNDATION_URL=
DERM_FOUNDATION_TOKEN=
DERM_FOUNDATION_TIMEOUT_MS=8000

# Skip ONNX Runtime's optional CUDA download during `npm install` on Linux
# (also set in .npmrc). Set this in CI/hosting environments too.
ONNXRUNTIME_NODE_INSTALL=skip
